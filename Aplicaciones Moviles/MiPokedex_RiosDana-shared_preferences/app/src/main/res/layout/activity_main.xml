<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/amarillo"
    tools:context=".MainActivity">
    
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glTopCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.28" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_begin="24dp" />

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/glEnd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_end="24dp" />

    <TextView
        android:id="@+id/txtNombrePkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/NombrePkmn"
        android:textColor="@color/white"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/txtNumeroPkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/NumeroPkmn"
        android:textColor="#50000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/txtNombrePkmn" />

    <ImageView
        android:id="@+id/imgPokeballBg"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:alpha="0.35"
        android:contentDescription="Pokeball background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/pokeball" />

    <View
        android:id="@+id/bgCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/card_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/glTopCard"
        app:layout_constraintVertical_bias="1.0" />

    <ImageView
        android:id="@+id/imgPokemon"
        android:layout_width="170dp"
        android:layout_height="170dp"
        android:elevation="10dp"
        android:contentDescription="Mimikyu"
        app:layout_constraintBottom_toTopOf="@id/glTopCard"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/glTopCard"
        app:srcCompat="@drawable/mimikyu" />

    <TextView
        android:id="@+id/txtTipo1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/rounded_badge"
        android:backgroundTint="@color/rosa"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:text="@string/PrmTipoPkmn"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/txtTipo2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imgPokemon" />

    <TextView
        android:id="@+id/txtTipo2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/rounded_badge"
        android:backgroundTint="@color/morado"
        android:paddingHorizontal="20dp"
        android:paddingVertical="6dp"
        android:text="@string/SgndTipoPkmn"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/txtTipo1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/txtTipo1"
        app:layout_constraintTop_toTopOf="@id/txtTipo1" />

    <TextView
        android:id="@+id/lblAltura"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/Altura"
        android:textColor="#B00000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/txtTipo1" />

    <TextView
        android:id="@+id/txtAlturaPkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="44dp"
        android:layout_marginBottom="16dp"
        android:text="@string/AlturaPkmn"
        android:textColor="#666666"
        android:textSize="18sp"
        app:layout_baseline_toBaselineOf="@id/lblAltura"
        app:layout_constraintBottom_toTopOf="@+id/txtPesoPkmn"
        app:layout_constraintStart_toEndOf="@id/lblAltura" />

    <TextView
        android:id="@+id/lblPeso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/Peso"
        android:textColor="#B00000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/lblAltura" />

    <TextView
        android:id="@+id/txtPesoPkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="52dp"
        android:text="@string/PesoPkmn"
        android:textColor="#666666"
        android:textSize="18sp"
        app:layout_baseline_toBaselineOf="@id/lblPeso"
        app:layout_constraintStart_toEndOf="@id/lblPeso"
        tools:layout_editor_absoluteY="398dp" />

    <TextView
        android:id="@+id/lblHabilidad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/Habilidad"
        android:textColor="#B00000"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintTop_toTopOf="@id/lblAltura" />

    <TextView
        android:id="@+id/txtHabilidadPkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="4dp"
        android:text="@string/HabilidadPkmn"
        android:textColor="#666666"
        android:textSize="18sp"
        app:layout_constraintStart_toStartOf="@id/lblHabilidad"
        app:layout_constraintTop_toBottomOf="@id/lblHabilidad" />

    <TextView
        android:id="@+id/txtDescripcion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/DescripcionHabilidadPkmn"
        android:textColor="#666666"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:layout_constraintTop_toBottomOf="@id/lblPeso" />

    <ImageView
        android:id="@+id/imgAntPkmn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginStart="40dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Togedemaru"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/glStart"
        app:srcCompat="@drawable/togedemaru" />

    <TextView
        android:id="@+id/txtAntPkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/AntPkmn"
        android:textColor="#666666"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgAntPkmn"
        app:layout_constraintVertical_bias="0.451"
        tools:layout_editor_absoluteX="32dp" />

    <ImageView
        android:id="@+id/imgSigPkmn"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:layout_marginEnd="36dp"
        android:layout_marginBottom="32dp"
        android:contentDescription="Bruxish"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/glEnd"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toEndOf="@+id/imgAntPkmn"
        app:srcCompat="@drawable/bruxish" />

    <TextView
        android:id="@+id/txtSigPkmn"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="136dp"
        android:text="@string/SigPkmn"
        android:textColor="#666666"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/txtAntPkmn"
        app:layout_constraintTop_toBottomOf="@+id/imgSigPkmn"
        app:layout_constraintVertical_bias="0.4" />

</androidx.constraintlayout.widget.ConstraintLayout>